{
  "name": "travel-canvas-personal",
  "main": "./src/cloud/index.ts",
  "compatibility_date": "2026-10-24",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-canvas-personal-db"
    }
  ],
  "triggers": {
    "crons": [
      "0 7 * * *"
    ]
  }
}
